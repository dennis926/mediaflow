{
  "name": "@mediaflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && node scripts/copy-seed-assets.mjs",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint \"src/**/*.ts\" --ext .ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migrate:prod": "typeorm migration:run -d dist/database/data-source.js",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "schema:log": "typeorm-ts-node-commonjs schema:log -d src/database/data-source.ts",
    "seed:knowledge": "ts-node src/database/seeds/seed-knowledge.ts",
    "test:e2e": "vitest run test/app.e2e.spec.ts",
    "seed:templates": "ts-node src/database/seeds/seed-templates.ts"
  },
  "dependencies": {
    "@mediaflow/channel-adapters": "workspace:*",
    "@mediaflow/shared": "workspace:*",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/typeorm": "10.0.2",
    "bcrypt": "5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "jszip": "3.10.1",
    "mammoth": "1.12.3",
    "multer": "^2.4.0",
    "nodemailer": "6.9.16",
    "pdf-parse": "1.1.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@swc/core": "1.11.24",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.25",
    "@types/multer": "1.4.13",
    "@types/node": "20.19.43",
    "@types/nodemailer": "6.4.17",
    "@types/pdf-parse": "1.1.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.9"
  }
}