# 应用
NODE_ENV=development
APP_PORT=4000
APP_HOST=127.0.0.1
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# 本机 3001 已被其它站点占用，H5 开发端口调整为本机可用端口
H5_URL=http://localhost:3101
# OAuth 回调前缀（配平台后台时填这里 + /api/accounts/oauth/<平台>/callback）
OAUTH_CALLBACK_BASE=http://localhost:4000

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediaflow
DB_USER=mediaflow
DB_PASSWORD=mediaflow_dev
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 后台「系统设置」里保存的密钥用什么加密（必填，长度 ≥32；空则启动失败）
# 生成：openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# 登录令牌签名密钥（必填，长度 ≥48；空或过短则启动失败）
# 生成：openssl rand -base64 36   注意：必须是 36 字节 → 48 字符；rand -base64 48 会得到 64 字符
# 并且必须与 SETTINGS_ENCRYPTION_KEY 不同
JWT_SECRET=change-me-openssl-rand-base64-36-at-least-48-chars-long
JWT_ACCESS_EXPIRES=2h
# 设为 false 可临时关闭鉴权（本地调试用），生产必须保持 true
AUTH_ENFORCED=true
JWT_REFRESH_EXPIRES=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mediaflow

# AI（DeepSeek V4-Flash）
AI_PROVIDER=deepseek
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-flash
# 自定义网关地址（留空使用官方 https://api.deepseek.com）；本地无 Key 时可用 AI_PROVIDER=mock
AI_API_BASE=

# 平台（按需填写）
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
XIAOHONGSHU_APP_ID=
XIAOHONGSHU_APP_SECRET=
# 小红书开放平台 API 地址（未配置时适配器不发起请求，仅返回明确报错）
XIAOHONGSHU_API_BASE=

# 发布队列
PUBLISH_WORKER_ENABLED=true
# 失败重试间隔（毫秒）；生产建议 300000（5 分钟）
PUBLISH_RETRY_INTERVAL_MS=15000
